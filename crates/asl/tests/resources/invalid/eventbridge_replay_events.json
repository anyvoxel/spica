{
  "Comment": "Replay a list of EventBridge events the same time they were orginally generated",
  "StartAt": "For Each Event",
  "States": {
    "For Each Event": {
      "End": true,
      "ItemProcessor": {
        "StartAt": "Convert past event to today",
        "States": {
          "Convert past event to today": {
            "Next": "Is event in the future?",
            "Arguments": {
              "FunctionName": "${functionArn}",
              "Payload": "{% $states.input %}"
            },
            "Resource": "arn:aws:states:::lambda:invoke",
            "Retry": [
              {
                "BackoffRate": 2,
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 6
              }
            ],
            "Type": "Task"
          },
          "Is event in the future?": {
            "Choices": [
              {
                "Next": "Wait",
                "Condition": "{% $states.input.process = true %}"
              }
            ],
            "Default": "Pass",
            "Type": "Choice"
          },
          "Pass": {
            "End": true,
            "Type": "Pass"
          },
          "Simulate Event": {
            "End": true,
            "Arguments": {
              "Entries": [
                {
                  "Detail": "{% $states.input.detail %}",
                  "DetailType": "{% $states.input.detail-type %}",
                  "EventBusName": "${EventBusName}",
                  "Source": "{% $states.input.source %}"
                }
              ]
            },
            "Resource": "arn:aws:states:::events:putEvents",
            "Type": "Task"
          },
          "Wait": {
            "Next": "Simulate Event",
            "Type": "Wait"
          }
        }
      },
      "MaxConcurrency": 40,
      "Type": "Map"
    }
  }
}
