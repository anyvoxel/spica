{
  "Comment": "A state machine that stands in for running an actual test. This one will simply wait for 5 seconds or for the number or seconds requested in the input.",
  "StartAt": "VerifyInput",
  "States": {
    "GenerateDefaultTestInput": {
      "Next": "RunTest",
      "Type": "Pass",
      "Output": {
        "delay-seconds": 5
      }
    },
    "RunTest": {
      "End": true,
      "Type": "Wait"
    },
    "VerifyInput": {
      "Choices": [
        {
          "Next": "RunTest",
          "Condition": "{% (% $exists($states.input.test-input.delay-seconds) = true %) and (% $type($states.input.test-input.delay-seconds) = 'number' %) %}"
        }
      ],
      "Default": "GenerateDefaultTestInput",
      "Type": "Choice"
    }
  }
}
