{
  "Comment": "A state machine that does mock stock trading.",
  "StartAt": "Check Stock Value",
  "States": {
    "Buy Stock": {
      "Next": "Record Transaction",
      "Arguments": {
        "ApiEndpoint": "${APIEndPoint}",
        "AuthType": "NO_AUTH",
        "Method": "POST",
        "Path": "${StockBuyPath}",
        "RequestBody": "{% $states.input.ResponseBody %}",
        "Stage": "Prod"
      },
      "Resource": "arn:aws:states:::apigateway:invoke",
      "Retry": [
        {
          "BackoffRate": 1,
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3
        }
      ],
      "Type": "Task"
    },
    "Buy or Sell?": {
      "Choices": [
        {
          "Next": "Buy Stock",
          "Condition": "{% $states.input.ResponseBody.stock_price <= 50 %}"
        }
      ],
      "Default": "Sell Stock",
      "Type": "Choice"
    },
    "Check Stock Value": {
      "Next": "Buy or Sell?",
      "Arguments": {
        "ApiEndpoint": "${APIEndPoint}",
        "AuthType": "NO_AUTH",
        "Method": "GET",
        "Path": "${StockCheckPath}",
        "RequestBody": "{% $states.input %}",
        "Stage": "Prod"
      },
      "Resource": "arn:aws:states:::apigateway:invoke",
      "Retry": [
        {
          "BackoffRate": 1.5,
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 15,
          "MaxAttempts": 5
        }
      ],
      "Type": "Task"
    },
    "Record Transaction": {
      "End": true,
      "Arguments": {
        "Item": {
          "Id": {
            "S": "{% $states.input.ResponseBody.id %}"
          },
          "Price": {
            "N": "{% $states.input.ResponseBody.price %}"
          },
          "Quantity": {
            "N": "{% $states.input.ResponseBody.qty %}"
          },
          "Timestamp": {
            "S": "{% $states.input.ResponseBody.timestamp %}"
          },
          "Type": {
            "S": "{% $states.input.ResponseBody.type %}"
          }
        },
        "TableName": "${DDBTable}"
      },
      "Resource": "${DDBPutItem}",
      "Retry": [
        {
          "BackoffRate": 10,
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 20,
          "MaxAttempts": 5
        }
      ],
      "Type": "Task"
    },
    "Sell Stock": {
      "Next": "Record Transaction",
      "Arguments": {
        "ApiEndpoint": "${APIEndPoint}",
        "AuthType": "NO_AUTH",
        "Method": "POST",
        "Path": "${StockSellPath}",
        "RequestBody": "{% $states.input.ResponseBody %}",
        "Stage": "Prod"
      },
      "Resource": "arn:aws:states:::apigateway:invoke",
      "Retry": [
        {
          "BackoffRate": 1,
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3
        }
      ],
      "Type": "Task"
    }
  }
}
