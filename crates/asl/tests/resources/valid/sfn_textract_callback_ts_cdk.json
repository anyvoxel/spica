{
  "StartAt": "textract",
  "States": {
    "Notify Success": {
      "End": true,
      "Arguments": {
        "Message": "Success",
        "TopicArn": "${SUCCESS_TOPIC_ARN}"
      },
      "Resource": "arn:aws:states:::aws-sdk:sns:publish",
      "Type": "Task"
    },
    "Wait for Textract Callback": {
      "Next": "Notify Success",
      "Arguments": {
        "MessageBody": {
          "MessageTitle": "Task started by Step Functions. Waiting for callback with task token.",
          "TaskToken": "{% $states.context.Task.Token %}"
        },
        "MessageGroupId": "{% $states.input.Result.JobId %}",
        "QueueUrl": "${QUEUE_URL}"
      },
      "Resource": "arn:aws:states:::sqs:sendMessage.waitForTaskToken",
      "Type": "Task"
    },
    "textract": {
      "Next": "Wait for Textract Callback",
      "Arguments": {
        "DocumentLocation": {
          "S3Object": "{% $states.input.Input %}"
        },
        "NotificationChannel": {
          "RoleArn": "${ROLE_ARN}",
          "SnsTopicArn": "${SNS_ARN}"
        },
        "OutputConfig": {
          "S3Bucket": "${S3_BUCKET}",
          "S3Prefix": "output"
        }
      },
      "Resource": "arn:aws:states:::aws-sdk:textract:startDocumentTextDetection",
      "Type": "Task"
    }
  }
}
