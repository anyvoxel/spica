{
  "Comment": "v1 - Resize uploaded images",
  "StartAt": "Resizer",
  "States": {
    "Publish": {
      "End": true,
      "Arguments": {
        "FunctionName": "${PublishFunctionArn}",
        "Payload": {
          "Input": "{% $states.input %}"
        }
      },
      "Resource": "arn:aws:states:::lambda:invoke",
      "Type": "Task"
    },
    "Resizer": {
      "Next": "Publish",
      "Resource": "${ResizerFunctionArn}",
      "Type": "Task"
    }
  }
}
