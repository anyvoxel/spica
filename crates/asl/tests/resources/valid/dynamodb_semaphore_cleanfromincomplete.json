          92,
          93,
          84,
          95,
          96,
          97,
          98,
          99,
          100
        ]
      }
    },
    "StartInParallel": {
      "End": true,
      "ItemProcessor": {
        "StartAt": "RunChildStateMachine",
        "States": {
          "ClearResults": {
            "End": true,
            "Type": "Pass"
          },
          "RunChildStateMachine": {
            "Catch": [
              {
                "ErrorEquals": [
                  "States.TaskFailed"
                ],
                "Next": "ClearResults"
              }
            ],
            "Next": "ClearResults",
            "Arguments": {
              "Input": {
                "AWS_STEP_FUNCTIONS_STARTED_BY_EXECUTION_ID": "{% $states.context.Execution.Id %}"
              },
              "StateMachineArn": "${StateMachineSemaphore}"
            },
            "Resource": "arn:aws:states:::states:startExecution.sync:2",
            "Retry": [
              {
                "BackoffRate": 5,
                "ErrorEquals": [
                  "StepFunctions.ExecutionAlreadyExistsException"
                ],
                "IntervalSeconds": 1,
                "MaxAttempts": 1
              },
              {
                "BackoffRate": 2,
                "ErrorEquals": [
                  "States.ALL"
                ],
                "IntervalSeconds": 1,
                "MaxAttempts": 12
              }
            ],
            "Type": "Task"
          }
        }
      },
      "MaxConcurrency": 0,
      "Type": "Map"
    }
  }
}
